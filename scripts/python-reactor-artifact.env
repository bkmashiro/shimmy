# Shared defaults for python-reactor.wasm consumers.
# Scripts may override any value by exporting it before sourcing this file.

: "${SHIMMY_REACTOR_REPO:=bkmashiro/webassembly-language-runtimes}"
: "${SHIMMY_REACTOR_VERSION:=v1.0.14}"
: "${SHIMMY_REACTOR_ASSET:=python-reactor.wasm}"
: "${SHIMMY_REACTOR_SHA256:=78dcbb6d673351c0d3b776c42d2fb93b6f638cdc714d58072dece4b115edaa72}"
: "${SHIMMY_REACTOR_ARTIFACT_DIR:=/tmp/shimmy-reactor-artifacts}"

SHIMMY_REACTOR_URL="https://github.com/${SHIMMY_REACTOR_REPO}/releases/download/${SHIMMY_REACTOR_VERSION}/${SHIMMY_REACTOR_ASSET}"
