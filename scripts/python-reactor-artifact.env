# Shared defaults for the pinned Agent Python Runtime bundle.
# Scripts may override any value before sourcing this file.

_SHIMMY_REACTOR_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
: "${SHIMMY_REACTOR_ARTIFACT_DIR:=${_SHIMMY_REACTOR_ROOT}/build/python-reactor/artifacts}"
: "${SHIMMY_REACTOR_ASSET:=agent-python-runtime-numpy-core.wasm}"
: "${SHIMMY_REACTOR_MANIFEST:=manifest.json}"
: "${SHIMMY_REACTOR_SHA256:=90c27951b2d8c2c7a8b42705b365cb4231c6dad207aad5260d55d2f9a85f1034}"
: "${SHIMMY_REACTOR_PRODUCER_COMMIT:=76b49158cc6c4824491561531bfe7e34872cb820}"

SHIMMY_REACTOR_WASM="${SHIMMY_REACTOR_ARTIFACT_DIR}/${SHIMMY_REACTOR_ASSET}"
SHIMMY_REACTOR_MANIFEST_PATH="${SHIMMY_REACTOR_ARTIFACT_DIR}/${SHIMMY_REACTOR_MANIFEST}"
unset _SHIMMY_REACTOR_ROOT
