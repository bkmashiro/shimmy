# Shared defaults for the Shimmy-owned Python runtime bundle.
# Scripts may override any value before sourcing this file.

_SHIMMY_REACTOR_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
: "${SHIMMY_REACTOR_ARTIFACT_DIR:=${_SHIMMY_REACTOR_ROOT}/dist/shimmy-python}"
: "${SHIMMY_REACTOR_ASSET:=shimmy-python-runtime-numpy-core.wasm}"
: "${SHIMMY_REACTOR_MANIFEST:=manifest.json}"
: "${SHIMMY_REACTOR_EXPECTED_COMMIT:=$(git -C "${_SHIMMY_REACTOR_ROOT}" rev-parse HEAD)}"

SHIMMY_REACTOR_WASM="${SHIMMY_REACTOR_ARTIFACT_DIR}/${SHIMMY_REACTOR_ASSET}"
SHIMMY_REACTOR_MANIFEST_PATH="${SHIMMY_REACTOR_ARTIFACT_DIR}/${SHIMMY_REACTOR_MANIFEST}"
unset _SHIMMY_REACTOR_ROOT
